  "scopeSemanticsVersion": "2.1.0",
  "canonicalRules": {
    "residualFieldVocabulary": [
      "effectiveQty",
      "openQty",
      "openQuantity",
      "qtyOpen",
      "quantityOpen",
      "remainingQty",
      "remainingQuantity",
      "qtyRemaining",
      "residualQty",
      "residualQuantity",
      "currentQty",
      "currentQuantity"
    ],
    "grossFieldVocabulary": [
      "qty",
      "quantity",
      "contracts"
    ],
    "precedence": "The FIRST residual field PRESENT wins outright. Only when no residual field is present does the gross vocabulary answer, in its own order.",
    "presenceRule": "PRESENT means an OWN property whose value is neither null nor undefined. An empty string is present (and invalid). A name inherited from the prototype is never present.",
    "invalidValueRule": "A present field whose value is not a finite number or a well-formed numeric string yields quantity null, status UNAVAILABLE, reason QUANTITY_INVALID, and quantitySource naming the field that failed. It NEVER falls through to a lower-precedence field or to the gross quantity.",
    "grossFallbackRule": "Only reached when no residual field is present at all.",
    "sideSignRule": "The sign is applied exactly once. A negative stored quantity means SHORT; a declared SHORT means SHORT; a negative quantity beside a declared LONG is SHORT — the stored sign wins. They are never multiplied together. With no usable quantity there is no position, so positionSide is null.",
    "closeMarkerFields": [
      "exitPrice",
      "closePrice",
      "closeDate",
      "closedAt",
      "closedDate",
      "exitDate",
      "exitSnapshot"
    ],
    "closeMarkerRule": "A close marker retires the leg ONLY when no explicit residual field carries a strictly positive quantity. An empty string, and an empty exitSnapshot object, record nothing and are not markers.",
    "noCurrentRisk": [
      "closed",
      "rolled",
      "assigned",
      "exercised",
      "cash_settled",
      "terminal",
      "residual_zero",
      "expired"
    ],
    "exitPriceWithPositiveExplicitResidual": "OPEN. A partial close records an exit price for the CLOSED portion while the explicit residual quantity is still at risk.",
    "exitPriceWithZeroOrAbsentResidual": "TERMINAL.",
    "missingQuantity": "UNAVAILABLE — never 1, never 0."
  }
}
