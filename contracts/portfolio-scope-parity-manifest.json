{
  "manifestId": "portfolio-scope-parity",
  "version": "2.0.0",
  "modelVersion": "1.2.2",
  "purpose": "Neutral, serializable fixtures for the cross-tier Portfolio scope parity contract (PST-PARITY-001..005). Revision 2.0.0 RECONCILES the taxonomy instead of merely recording the divergence: closed, rolled, assigned, exercised, cash-settled, terminal and residual-zero all mean NO CURRENT RISK in both tiers. The BACKEND produces canonical outcomes for these fixtures; a companion apex-trading PR must consume this same manifest and produce identical outcomes. A mismatch of manifest version, manifest sha256 or scope-semantics version makes the run UNAVAILABLE with PORTFOLIO_SCOPE_PARITY_DIVERGENCE.",
  "shaScope": "sha256 over the canonical JSON of the `fixtures` array only, so prose edits above do not churn the hash",
  "sha256": "4a1a3d9835b0b859dc0d7452d39bca65546a654acabd6b18f7675a5d4b57fe1e",
  "consumerContract": {
    "backend": "tests/portfolio-scope-parity.test.js produces canonicalOutcomes and asserts them against `expected`",
    "frontend": "a companion PR in apex-trading must load this manifest and produce identical outcomes from its own scope owners",
    "onDivergence": "the stress run is UNAVAILABLE with reason PORTFOLIO_SCOPE_PARITY_DIVERGENCE"
  },
  "fixtures": [
